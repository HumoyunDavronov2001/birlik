{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node", "@testing-library/jest-dom"]
  },
  "include": ["src/**/*", ".storybook/**/*", "tests/**/*", "scripts/**/*", "vite.config.ts", "vitest.setup.ts", "playwright.config.ts"]
}
