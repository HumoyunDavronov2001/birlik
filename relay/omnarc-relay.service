[Unit]
Description=Omnarc relay (iroh-relay)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/iroh-relay --config-path /etc/omnarc-relay/omnarc-relay.toml
EnvironmentFile=/etc/omnarc-relay/token.env
DynamicUser=yes
StateDirectory=omnarc-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
