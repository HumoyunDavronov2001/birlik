+// layer window: whether the model loads the tensor
+static bool llama_layer_window_has(const llama_model & model, const LLM_TN_IMPL & tn, int flags) {
+    const int n_layer = model.hparams.n_layer();
+    const int begin   = model.layer_begin();
+    const int end     = model.layer_end();
+    if (begin == 0 && end == n_layer + 1) {
+        return true;
+    }
+
+    // the token embeddings that are duplicated as the output belong to the output layer
+    const llm_tensor tensor = tn.tensor == LLM_TENSOR_TOKEN_EMBD && (flags & llama_model_loader::TENSOR_DUPLICATED)
+        ? LLM_TENSOR_OUTPUT : tn.tensor;
+
+    switch (llm_tensor_info_for(tensor).layer) {
+        case LLM_TENSOR_LAYER_INPUT:  return begin == 0;
+        case LLM_TENSOR_LAYER_OUTPUT: return end > n_layer;
+        default:                      return tn.bid >= begin && tn.bid < end;
+    }
+}
